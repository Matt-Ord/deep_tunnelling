{
    "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
    "version": "0.2",
    "language": "en",
    "words": [
        "Caldeira",
        "CASTEP",
        "eigenbasis",
        "eigenstate",
        "eigenstates",
        "HREELS",
        "Jianding",
        "Lanczos",
        "Lindblad",
        "Liouvillian",
        "PCCP",
        "Rudner",
        "TDDFT"
    ],
    "ignoreWords": [
        "axhspan",
        "bmat",
        "coeffs",
        "dtau",
        "eigh",
        "eigs",
        "eigsh",
        "fftfreq",
        "frameon",
        "ifft",
        "infty",
        "interp",
        "isort",
        "kpoints",
        "kron",
        "mathbb",
        "mathbf",
        "mathrm",
        "mathsf",
        "matvec",
        "ndarray",
        "numpy",
        "Phonopy",
        "Pickler",
        "pydata",
        "pydocstyle",
        "pylint",
        "pyproject",
        "pytest",
        "rtol",
        "savez",
        "scipy",
        "sxyi",
        "sxyz",
        "tocsc",
        "tocsr",
        "tqdm",
        "trange",
        "Unpickler",
        "Wannier",
        "xlabel",
        "xyij",
        "yerr",
        "ylabel",
        "zorder"
    ],
    "flagWords": [
        "hte",
        "teh"
    ],
    "allowCompoundWords": true,
    "maxNumberOfProblems": 1000,
    "ignorePaths": [
        "*.snap",
        "node_modules",
        "__snapshots__",
        "package-lock.json",
        "coverage/**",
        "dist/**",
        "dist.*/**",
        "temp/**",
        "CHANGELOG.md",
        "package.json",
        ".cspell.json",
        "cspell.json",
        ".vscode/**",
        ".devcontainer/**",
        ".github/**",
        ".pytest_cache/**",
        ".ruff_cache/**",
        ".venv/**",
        ".vscode/**",
        "build/**",
        "docs/**",
        "*.egg-info/**"
    ],
    "noConfigSearch": true
}
